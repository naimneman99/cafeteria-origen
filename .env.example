# Copiar a .env y reemplazar los valores de ejemplo por secretos propios.
# El archivo .env no se versiona.

# Puerto publicado en el host
APP_PORT=8080

# Contraseña del superusuario postgres (solo para administrar la base)
POSTGRES_PASSWORD=cambiar-postgres

# Contraseña del usuario de aplicación origen_app
DB_PASSWORD=cambiar-origen-app
